# Настройки бота на сервере: /etc/newsbot/newsbot.env (права 600: читает только root, systemd передаёт их службе)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# id владелицы: сюда итоги ошибок и еженедельная копия базы
ADMIN_CHAT_ID=
# Кто может пользоваться агентом (id через запятую) — владелица
ALLOWED_USER_IDS=
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
GNEWS_API_KEY=
COLLECT_INTERVAL_MINUTES=120
